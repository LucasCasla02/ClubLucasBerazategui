# Plantilla de configuración. NO pongas datos reales en este archivo.
# Copialo con el nombre .env y completa tus valores. El .env nunca se sube a GitHub.

# Base de datos local (PostgreSQL instalado en tu compu)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=club_db
DB_USER=postgres
DB_PASSWORD=escribi_aca_tu_contrasena

# En Render se usa DATABASE_URL en lugar de los datos de arriba.
# En tu compu dejala vacía.
DATABASE_URL=